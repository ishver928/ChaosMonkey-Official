# Chaos Monkey backend configuration. Copy to .env and adjust.
# Everything here points at the local machine only. No cloud endpoints are ever used.

# Local LLM (Ollama). Must be a localhost URL — a non-local host aborts startup.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5-coder:7b-instruct
EMBED_MODEL=nomic-embed-text

# Determinism
SEED=42
LLM_TEMPERATURE=0
LLM_TOP_K=1
LLM_TOP_P=1

# Set to 1 to use recorded/mock LLM responses (tests, offline demos). No network at all.
LLM_MOCK=0

# Server
HOST=127.0.0.1
PORT=8000

# SQLite cache + scan store location (relative to backend/)
DB_PATH=chaosmonkey.db

# Max file size to ingest (bytes)
MAX_FILE_BYTES=1000000
